# =================================================================
# SAAS Nexus Backend Environment Configuration
# Copy this file to .env and fill in your local or production values
# =================================================================

# Server & Application
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database & Authentication (REQUIRED)
MONGO_URI=mongodb://127.0.0.1:27017/saas_nexus
JWT_SECRET=saas_nexus_super_secret_jwt_key_2026_change_in_production

# Firebase Admin SDK (Optional: Used for Firebase authentication sync)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Google Calendar & Meet Integration (Optional: Auto-generates fallback meet links if unset)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
GOOGLE_CALENDAR_ID=primary
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_IMPERSONATED_ADMIN_EMAIL=

# SMTP Email Notifications (Optional: System logs email content to console if unconfigured)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SAAS Nexus Workspace" <no-reply@nexus.corp>
